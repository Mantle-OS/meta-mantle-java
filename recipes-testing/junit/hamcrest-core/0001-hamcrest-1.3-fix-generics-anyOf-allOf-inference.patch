From 669ab29296f01e13ec43d4ce82adbe163fa51bf6 Mon Sep 17 00:00:00 2001
From: JosephMillsAtWork <josephjamesmills@gmail.com>
Date: Wed, 8 Oct 2025 09:11:09 +0000
Subject: [PATCH] hamcrest-1.3-fix-generics-anyOf-allOf-inference

Signed-off-by: JosephMillsAtWork <josephjamesmills@gmail.com>
---
 org/hamcrest/core/AllOf.java | 3 ++-
 org/hamcrest/core/AnyOf.java | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/org/hamcrest/core/AllOf.java b/org/hamcrest/core/AllOf.java
index a206b80..7dc0068 100644
--- a/org/hamcrest/core/AllOf.java
+++ b/org/hamcrest/core/AllOf.java
@@ -57,7 +57,8 @@ public class AllOf<T> extends DiagnosingMatcher<T> {
      */
     @Factory
     public static <T> Matcher<T> allOf(Matcher<? super T>... matchers) {
-        return allOf(Arrays.asList(matchers));
+        return allOf((Iterable<Matcher<? super T>>) Arrays.<Matcher<? super T>>asList(matchers));
+
     }
 
     /**
diff --git a/org/hamcrest/core/AnyOf.java b/org/hamcrest/core/AnyOf.java
index 55d08dd..e9958c1 100644
--- a/org/hamcrest/core/AnyOf.java
+++ b/org/hamcrest/core/AnyOf.java
@@ -47,7 +47,7 @@ public class AnyOf<T> extends ShortcutCombination<T> {
      */
     @Factory
     public static <T> AnyOf<T> anyOf(Matcher<? super T>... matchers) {
-        return anyOf(Arrays.asList(matchers));
+        return anyOf((Iterable<Matcher<? super T>>) Arrays.<Matcher<? super T>>asList(matchers));
     }
 
     /**
-- 
2.51.0

